# Copy this file to .env and adjust values as needed.
# Never commit the real .env file.

# --- Database ---
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- JWT ---
# Must be identical across auth-service, expense-service, and api-gateway.
JWT_SECRET=change-this-to-a-long-random-secret-key-in-production-please
JWT_EXPIRATION_MS=3600000

# --- Ports (host-side, in case of conflicts with other local services) ---
GATEWAY_PORT=8080
AUTH_PORT=8081
EXPENSE_PORT=8082
AUDIT_PORT=8083
